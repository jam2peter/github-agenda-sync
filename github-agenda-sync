#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

load_env() {
  if [ -f .env ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env
    set +a
  fi
}

cmd="${1:-help}"
case "$cmd" in
  init)
    exec "$ROOT/install.sh"
    ;;
  setup)
    chmod +x "$ROOT/scripts/configure_github.sh" || true
    echo
    echo "GitHub Agenda Sync guided setup"
    echo
    if [ ! -f .env ]; then
      cp .env.example .env
      echo "Created .env from template."
    fi
    if [ -f "$ROOT/scripts/google_oauth_setup.py" ]; then
      echo "Google OAuth helper:"
      echo "  python3 scripts/google_oauth_setup.py /path/to/google-oauth-client.json"
      echo
    fi
    exec "$ROOT/scripts/configure_github.sh" "${2:-}"
    ;;
  doctor)
    load_env
    failed=0
    check() {
      local name="$1" value="${2:-}"
      if [ -n "$value" ]; then
        printf '%-34s PASS\n' "$name"
      else
        printf '%-34s FAIL\n' "$name"
        failed=1
      fi
    }
    command -v python3 >/dev/null && printf '%-34s PASS\n' 'Python 3' || { printf '%-34s FAIL\n' 'Python 3'; failed=1; }
    check 'GitHub token' "${GH_AGENDA_GITHUB_TOKEN:-}"
    check 'Repository list' "${GH_AGENDA_REPOSITORIES:-}"
    check 'Google client id' "${GOOGLE_CLIENT_ID:-}"
    check 'Google client secret' "${GOOGLE_CLIENT_SECRET:-}"
    check 'Google refresh token' "${GOOGLE_REFRESH_TOKEN:-}"
    check 'Google timezone' "${GOOGLE_TIMEZONE:-}"
    if [ "$failed" -eq 0 ]; then
      echo 'SYSTEM_READY=YES'
    else
      echo 'SYSTEM_READY=NO'
      exit 1
    fi
    ;;
  sync)
    load_env
    exec python3 "$ROOT/src/github_agenda_sync.py"
    ;;
  status)
    load_env
    echo "REPOSITORIES=${GH_AGENDA_REPOSITORIES:-NOT_CONFIGURED}"
    echo "TASKLIST=${GOOGLE_TASKLIST_ID:-@default}"
    echo "CALENDAR=${GOOGLE_CALENDAR_ID:-primary}"
    echo "TIMEZONE=${GOOGLE_TIMEZONE:-UTC}"
    ;;
  help|-h|--help)
    cat <<'EOF'
GitHub Agenda Sync

Usage:
  ./github-agenda-sync init
  ./github-agenda-sync setup [owner/repository]
  ./github-agenda-sync doctor
  ./github-agenda-sync sync
  ./github-agenda-sync status
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    exit 2
    ;;
esac
